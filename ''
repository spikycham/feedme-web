.food-list {
    display: flex;
    flex-direction: column;
    gap: var(--std-sm-gap);

    > h1 {
        text-align: center;
        font-weight: normal;

        > span {
            display: block;
        }
    }

    > .search {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--std-sm-gap);
        padding: 15px 20px;
        background-color: var(--color-gray);
        border-radius: 30px;

        > label {
            height: 18px;
        }

        svg {
            width: 18px;
            height: 18px;
        }

        > input {
            border: none;
            outline: none;
            font-size: 14px;
            width: 100%;
            background-color: inherit;
        }

        > .filter {
            height: 18px;
        }
    }

    > ul {
        --img-width: 60px;
        display: flex;
        flex-direction: column;
        gap: var(--std-sm-gap);

        > li {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 10px;
            border-radius: var(--std-br);
            background-color: var(--color-gray);

            > .info {
                display: flex;
                align-items: start;
                gap: var(--std-sm-gap);

                > .photo {
                    flex: 0 0 var(--img-width);
                    width: var(--img-width);
                    height: var(--img-width);
                    border-radius: var(--std-br);
                    overflow: hidden;

                    > img {
                        height: 100%;
                        object-fit: contain;
                    }
                }

                > .text {
                    > h3 {
                        font-weight: normal;
                    }
                    > p {
                        color: var(--color-fg-gray);
                    }
                    > p.price {
                        color: var(--color-fg);
                        font-size: 18px;
                    }
                }
            }

            > .action {
                display: flex;
                flex-direction: column;
                align-items: end;
                justify-content: space-between;
                gap: 5px;

                > p {
                    font-size: 18px;
                    margin-right: 5px;
                }

                .buttons {
                    align-self: center;
                    display: flex;
                    align-items: center;
                    gap: var(--std-sm-gap);
                    padding: 5px;
                    width: max-content;
                    background-color: var(--color-bg);
                    border-radius: 20px;

                    > .rmv,
                    > .add {
                        display: grid;
                        place-items: center;
                        width: 30px;
                        height: 30px;
                        border-radius: 20px;
                        font-size: 18px;
                    }
                    > .rmv {
                        color: var(--color-fg);
                        background-color: var(--color-gray);
                    }
                    > .add {
                        color: var(--color-gray);
                        background-color: var(--color-fg);
                    }
                }
            }
        }
    }
}

.food-detail {
    display: flex;
    flex-direction: column;
    gap: var(--std-sm-gap);

    h3 {
        margin-bottom: 5px;
    }
    > p {
        color: var(--color-fg-gray);
    }

    .info {
        display: flex;
        flex-direction: column;
        align-items: start;

        > .ic,
        .txt {
            display: flex;
            align-items: center;
            gap: var(--std-lg-gap);

            > div {
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 5px;

                > svg {
                    width: 18px;
                }
            }
        }
    }

    .ig-container {
        display: flex;
        gap: var(--std-sm-gap);
        flex-wrap: wrap;

        .ingredient {
            display: block;
            background-color: var(--color-gray);
            border-radius: 20px;
            padding: 4px 8px;
        }
    }

    .cm-container {
        display: flex;
        flex-direction: column;
        gap: var(--std-sm-gap);

        > p {
            padding: 8px 16px;
            background-color: var(--color-gray);
            border-radius: var(--std-br);

            > span {
                display: block;
            }
        }
    }
}
